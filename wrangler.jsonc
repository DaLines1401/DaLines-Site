{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalines-site",
  "compatibility_date": "2024-09-23",
  "main": "./worker.js",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
